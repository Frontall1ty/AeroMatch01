# PostgreSQL connection string (Neon, Supabase, or local).
# With the Neon integration in Vercel, DATABASE_URL and DATABASE_URL_UNPOOLED are added for you.
DATABASE_URL="postgresql://aero:aero@localhost:5432/aeromatch"
# Signs the demo role cookie. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: when set, the whole site asks for this passcode first.
DEMO_PASSCODE=""
# Show the "Reset demo data" button in the footer (set to false for shared links).
ALLOW_DEMO_RESET="true"
# Days from seed day to the first seeded departure (keeps demo dates fresh).
DEMO_READY_OFFSET_DAYS="3"
# Passcode for the admin page (verifying carriers by hand). Leave empty to switch admin off.
ADMIN_PASSCODE=""
# Set to false to close sign-up.
ALLOW_REGISTRATION="true"
# Set to false to hide the passwordless demo accounts.
ALLOW_DEMO_ACCOUNTS="true"
