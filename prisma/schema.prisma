generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  SHIPPER
  CARRIER
  FORWARDER
  GSA
}

enum Role {
  SHIPPER
  CARRIER
}

enum Mode {
  AIR
  ROAD
  RAIL
  SEA
}

enum PricingUnit {
  PER_KG
  PER_M2
  PER_VEHICLE
  FLAT
}

enum CargoKind {
  GENERAL
  VEHICLES
}

enum ListingStatus {
  OPEN
  FULL
  CLOSED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  IN_PROGRESS
  DELIVERED
}

model Company {
  id          String      @id @default(cuid())
  name        String
  type        CompanyType
  verified    Boolean     @default(false)
  verifiedAt  DateTime?
  country     String
  city        String?
  phone       String?
  address     String?
  taxId       String?
  website     String?
  about       String?
  createdAt   DateTime    @default(now())
  users     User[]
  listings  CapacityListing[]
  shipments ShipmentRequest[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  role         Role
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model CapacityListing {
  id                    String        @id @default(cuid())
  carrierCompanyId      String
  carrier               Company       @relation(fields: [carrierCompanyId], references: [id])
  mode                  Mode
  origin                String
  destination           String
  departureDate         DateTime      @db.Date
  availableWeightKg     Float
  availableVolumeM3     Float
  cargoKind             CargoKind     @default(GENERAL)
  pricingUnit           PricingUnit   @default(PER_KG)
  unitPrice             Float
  availableFloorM2      Float?
  availableVehicles     Int?
  currency              String        @default("USD")
  transitDaysMin        Int
  transitDaysMax        Int
  equipment             String
  cutoffHours           Int
  maxPieceKg            Float
  acceptsDangerousGoods Boolean       @default(false)
  minChargeableKg       Float         @default(0)
  restrictions          String        @default("")
  safetyScore           Int           @default(3)
  capacityWeightKg      Float?
  capacityVehicles      Int?
  status                ListingStatus @default(OPEN)
  isDemo                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  bookings              Booking[]

  @@index([origin, destination, status])
  @@index([carrierCompanyId])
}

model ShipmentRequest {
  id                 String   @id @default(cuid())
  shipperCompanyId   String
  shipper            Company  @relation(fields: [shipperCompanyId], references: [id])
  origin             String
  destination        String
  weightKg           Float
  volumeM3           Float
  cargoKind          CargoKind @default(GENERAL)
  pieces             Int      @default(1)
  floorAreaM2        Float?
  pieceLengthCm      Int?
  pieceWidthCm       Int?
  pieceHeightCm      Int?
  pieceWeightKg      Float?
  stackable          Boolean  @default(false)
  vehicleCount       Int?
  heaviestPieceKg    Float?
  isDangerousGoods   Boolean  @default(false)
  cargoType          String
  commodity          String   @default("")
  readyDate          DateTime @db.Date
  deliverBy          DateTime @db.Date
  notes              String   @default("")
  createdAt          DateTime @default(now())
  bookings           Booking[]
}

model Booking {
  id                  String          @id @default(cuid())
  shipmentRequestId   String
  shipment            ShipmentRequest @relation(fields: [shipmentRequestId], references: [id])
  listingId           String
  listing             CapacityListing @relation(fields: [listingId], references: [id])
  chargeableWeightKg  Float
  totalPrice          Float
  status              BookingStatus   @default(REQUESTED)
  rejectionReason     String?
  createdAt           DateTime        @default(now())
  events              BookingEvent[]

  @@index([listingId])
  @@index([shipmentRequestId])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  milestone String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([bookingId, milestone])
  @@index([bookingId])
}
